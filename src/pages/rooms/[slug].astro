---
import Layout from "../../components/layout/Layout.astro";
//import { rooms } from "../../lib/constants";
import { Image } from "astro:assets";
import AmenityListing from "@/components/listings/AmenityListing.astro";
import FeatureListing from "@/components/listings/FeatureListing.astro";
import Reservation from "@/components/forms/Reservation";
import { fetchRooms } from "@/lib/queries/roomQuery";
import type { Room } from "../../../sanity.types";
import { urlForImage } from "@/lib/url-for-image";


export const getStaticPaths = async () => {
  const rooms: Room[] = await fetchRooms('luxury-suite','royal-room',true);
  return rooms.map((room) => ({
    params: { slug: room.slug },
  }));
};
const { slug } = Astro.params;
const rooms = await fetchRooms('luxury-suite','royal-room',true);
const roomQuery = rooms.find((room) => room.slug === slug);
console.log(rooms);
debugger;
if (slug === undefined) {
