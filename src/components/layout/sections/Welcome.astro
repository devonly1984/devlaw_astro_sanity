---
import { ratings } from "@/lib/ratings";
---

<section class="pt-28">
  <div class="container">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-300 md:text-600 font-600 mb-1">
        Welcome to StayLite Hotel
      </h2>
      <p class="md:text-lg text-muted-foreground">
        Nestled in a prime location, StayLite Hotel offers a perfect blend
        of luxury,comfort, and exceptional service. Whether you're
        traveling for business or pleasure, our dedicated staff ensures
        your stay is nothing short of extraordinary.
      </p>
      <div class="mt-10 flex justify-center gap-6">
        {
          ratings.map((rating) => (
            <div class="">
              <h3 class="text-3xl font-bold">{rating.name}</h3>
              <p class="text-muted-foreground">{rating.subtitle}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
